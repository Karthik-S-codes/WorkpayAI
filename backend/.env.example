# ==============================================================================
# WorkPay AI Backend Environment Configuration Template
# Copy this file to backend/.env
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5180

# Database Configuration (MySQL 8 Local Windows Installation)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_LOCAL_MYSQL_PASSWORD
DB_NAME=workpay_ai

# Authentication & JWT
JWT_SECRET=workpay_ai_jwt_production_secret_key_change_in_prod
JWT_EXPIRES_IN=7d

# FinTech / Digital Payments (Sandbox Mode)
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_workpayai2026
RAZORPAY_KEY_SECRET=rzp_secret_dummy_test_key_workpay
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_workpay_2026

# AI Engine (Google Gemini Flash API key)
GEMINI_API_KEY=your_gemini_api_key_here
